# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=your-key-here
# Comma-separated: falls back to the next model on quota or overload errors
GEMINI_MODEL=gemini-3.5-flash,gemini-3.1-flash-lite,gemini-2.5-flash
GEMINI_EMBED_MODEL=gemini-embedding-001

# GitHub personal access token (fine-grained: Issues read/write on the target repo).
# Used by the hosted GitHub MCP server and by our triage MCP server.
GITHUB_TOKEN=
GITHUB_REPOSITORY=owner/repo

# true = writes (labels, comments) are blocked at the tool layer and only reported
DRY_RUN=true

# Optional: free models via https://openrouter.ai/keys (use with --model openrouter:<model-id>)
OPENROUTER_API_KEY=
